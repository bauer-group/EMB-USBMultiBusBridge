; Copyright (c) 2026 BAUER GROUP
;
; Simple 8N1 UART RX in PIO. Ported from pico-examples
; (pio/uart_rx/uart_rx.pio). Samples each bit in the middle of its
; bit period, verifies the stop bit, and pushes the 8 data bits
; right-aligned into the SM RX FIFO.
;
; Timing contract: the SM clock divider MUST yield 8 cycles per bit.
; The wait-for-start + delay chain accumulates 12 cycles between the
; falling edge of the start bit and the first data-bit sample, so we
; sample in the middle of bit 0 instead of on its leading edge.
;
; Framing errors: if the stop bit reads LOW instead of HIGH we raise
; IRQ 4 relative (useful in a multi-SM debug build); in production we
; just silently drop the byte. Users wanting framing-error visibility
; can register an IRQ handler and surface it via EVENT frames.

.program rpbridge_uart_pio_rx

start:
    wait 0 pin 0        ; Block until we see the start bit falling edge.
    set x, 7    [10]    ; Preload bit counter, then wait 10 + 1 = 11 cycles.
                        ; Combined with the 1-cycle `wait` we are ~12 cycles
                        ; in, i.e. middle of the first data bit.
bitloop:
    in pins, 1          ; Sample one bit.
    jmp x-- bitloop [6] ; 8-cycle loop.
    jmp pin good_stop   ; Stop bit should read HIGH.
    irq 4 rel           ; Framing error — sticky signal to the host.
    wait 1 pin 0        ; Wait until the line returns to idle.
    jmp start           ; Discard this byte.
good_stop:
    push                ; Commit the byte to the RX FIFO.
