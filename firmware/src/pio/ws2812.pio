; SPDX-License-Identifier: BSD-3-Clause
; Copyright (c) 2026 BAUER GROUP
;
; WS2812 / NeoPixel NRZ encoder for one PIO state machine.
;
; Each bit = 1.25 µs nominal (800 kHz). Within that bit:
;   '0' = ~0.4 µs HIGH + ~0.85 µs LOW
;   '1' = ~0.8 µs HIGH + ~0.45 µs LOW
;
; Implementation breaks the bit into three slices controlled by side-set
; on every instruction (matches pico-examples ws2812.pio exactly):
;   T1 (HIGH at bit start, both 0 and 1) — 2 cycles
;   T2 (HIGH only for 1, LOW for 0)      — 5 cycles
;   T3 (LOW tail, both 0 and 1)          — 3 cycles
;   total = 10 cycles per bit
;
; '0' bit = 0.25 µs HIGH + 1.00 µs LOW  (spec: ~0.4 µs + ~0.85 µs ± 0.15)
; '1' bit = 0.875 µs HIGH + 0.375 µs LOW (spec: ~0.8 µs + ~0.45 µs ± 0.15)
;
; SM clock = 8 MHz (10 cycles × 0.125 µs = 1.25 µs/bit). Set
; clkdiv = clk_sys / 8e6 — the c-sdk init below does that for you.
;
; FIFO usage: 32-bit words shifted MSB-first by `out`. Each call to
; pio_sm_put_blocking pushes one word; the C side packs GRB triplets
; left-aligned (RGB → 0xGGRRBB00 in MSB order, top 24 bits used).
;
; Reset / latch is generated in software by holding the SM idle for
; >= 50 µs. The C driver enforces this between frame writes.
;
; Pin mapping:
;   side-set pin 0 = WS2812 data
;   OUT base       = WS2812 data (set_consecutive_pindirs uses it)

.program rpbridge_ws2812
.side_set 1

.wrap_target
bitloop:
    out x, 1        side 0 [2]   ; T3 (LOW, 3 cycles incl. instr) — pull bit
    jmp !x do_zero  side 1 [1]   ; T1 starts HIGH (2 cycles incl. instr)
do_one:
    jmp bitloop     side 1 [4]   ; T2 keeps HIGH for '1' (5 cycles)
do_zero:
    nop             side 0 [4]   ; T2 drops LOW for '0' (5 cycles)
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void rpbridge_ws2812_program_init(PIO pio, uint sm,
                                                uint offset, uint pin)
{
    pio_sm_config c = rpbridge_ws2812_program_get_default_config(offset);

    sm_config_set_sideset_pins(&c, pin);
    sm_config_set_out_shift   (&c, false /*shift_left*/, true /*autopull*/, 24);
    sm_config_set_fifo_join   (&c, PIO_FIFO_JOIN_TX);

    /* SM at 8 MHz so each bit is 10 cycles × 1/8 MHz = 1.25 µs. */
    float div = (float)clock_get_hz(clk_sys) / 8000000.0f;
    sm_config_set_clkdiv(&c, div);

    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
