# SPDX-License-Identifier: GPL-2.0
#
# DKMS recipe for the RPBridge Rust kernel driver. The build step shells
# out to our wrapper Makefile, which in turn invokes the kernel's own
# Rust-for-Linux build rules. DKMS only needs to know how to produce
# rpbridge.ko and where to install it.

PACKAGE_NAME="rpbridge"
PACKAGE_VERSION="@VERSION@"

CLEAN="make clean"
MAKE[0]="make KDIR=/lib/modules/${kernelver}/build"

BUILT_MODULE_NAME[0]="rpbridge"
BUILT_MODULE_LOCATION[0]="."
DEST_MODULE_LOCATION[0]="/updates"

# Auto-install on future kernel upgrades.
AUTOINSTALL="yes"

# The module only loads on kernels that have Rust-for-Linux enabled.
# If the user's current kernel is missing CONFIG_RUST, DKMS's generic
# "module not found" fallback is fine — the wrapper Makefile returns a
# non-zero exit with an explanatory message before any build work.
REMAKE_INITRD="no"
