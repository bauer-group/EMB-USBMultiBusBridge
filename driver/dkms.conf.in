# SPDX-License-Identifier: GPL-2.0
#
# DKMS recipe for the RPBridge C kernel driver. The build step shells
# out to our wrapper Makefile, which in turn invokes plain kbuild
# against /lib/modules/${kernelver}/build. DKMS only needs to know
# how to produce rpbridge.ko and where to install it.

PACKAGE_NAME="rpbridge"
PACKAGE_VERSION="@VERSION@"

CLEAN="make clean"
MAKE[0]="make KDIR=/lib/modules/${kernelver}/build"

BUILT_MODULE_NAME[0]="rpbridge"
BUILT_MODULE_LOCATION[0]="."
DEST_MODULE_LOCATION[0]="/updates"

# Auto-install on future kernel upgrades.
AUTOINSTALL="yes"

# The module compiles against any kernel from 5.15 onwards (the
# auxiliary_bus baseline). No CONFIG_RUST gate; Linux's stable
# kernel-module ABI carries the binary forward across major
# kernel releases. See driver/kernel-baseline/SUPPORT.md for the
# full distribution / kernel-version compatibility matrix.
REMAKE_INITRD="no"
