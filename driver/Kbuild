# Kbuild recipe for the RPBridge C kernel driver.
#
# Set CONFIG_RPBRIDGE=m in the kernel config (or rely on DKMS, which
# passes -C CONFIG_MODULES=y M=$PWD to the kernel build system).

obj-m := rpbridge.o

# Object list is built up incrementally as subsystem clients land.
# The minimum-viable scaffold is just the USB driver entry point and
# the wire-protocol layer (RPBP framing + CRC-32C); subsystem
# auxiliary children get appended here as they are implemented.
rpbridge-y := \
	src/main.o          \
	src/rpbp_framing.o  \
	src/rpbp_crc32c.o   \
	src/transport.o     \
	src/cap.o           \
	src/session.o       \
	src/auxbus.o        \
	src/gpio.o          \
	src/i2c.o           \
	src/spi.o           \
	src/pwm.o

# Strict warning posture matching the firmware's bar. Kernel build
# already adds -Wall + -Wextra subset; these are the additional
# checks that catch real-world driver bugs (uninit reads, missing
# prototypes, unused variables, etc.).
ccflags-y := \
	-DRPBRIDGE_MODULE             \
	-Wstrict-prototypes           \
	-Wmissing-prototypes          \
	-Wno-declaration-after-statement \
	-Werror=implicit-function-declaration \
	-Werror=return-type
