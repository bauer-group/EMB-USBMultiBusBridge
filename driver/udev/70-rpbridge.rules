# SPDX-License-Identifier: GPL-2.0
#
# udev rules for the RPBridge USB multi-bus bridge.
#
# Install: copy to /etc/udev/rules.d/70-rpbridge.rules (or the matching
# path under /lib/udev/rules.d/ if installed via a .deb/.rpm package),
# then `sudo udevadm control --reload && sudo udevadm trigger`.
#
# Production VID/PID: 0545:0101 (BAUER GROUP — RPBridge), allocated
# 2026-04-27. Keep in lock-step with firmware/src/usb/usb_descriptors.c
# and driver/src/rpbp.h.

# Access + stable symlink for the composite RPBridge device.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0545", ATTRS{idProduct}=="0101", \
    MODE="0660", GROUP="plugdev", TAG+="uaccess", \
    SYMLINK+="rpbridge%n"

# Access + stable symlink for the RP2350 ROM-BOOTSEL device
# (picotool / UF2 mass-storage target).
SUBSYSTEM=="usb", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="000f", \
    MODE="0660", GROUP="plugdev", TAG+="uaccess", \
    SYMLINK+="rpbridge-bootsel"

# Four CDC-ACM virtual serial ports — one per physical layer so a
# stock terminal can reach any phy by opening the matching symlink.
#
#   /dev/rpbridge-uart1-rs232   CDC #0  →  UART0 HW via MAX3232
#   /dev/rpbridge-uart1-rs485   CDC #1  →  UART0 HW via SN65HVD72 (auto DE)
#   /dev/rpbridge-uart1-ttl     CDC #2  →  UART0 HW direct drive (header #1)
#   /dev/rpbridge-uart2         CDC #3  →  PIO-UART #2 (header #2, TTL)
#
# The firmware watches CDC DTR and switches the UART0 phy-bank
# transceiver to match whichever of CDC 0/1/2 currently has DTR=1.
# Opening the right COM is all the user has to do — no driver, no
# rpbridge-ctl, no custom library.
#
# Note: the firmware does NOT expose a USB debug-log CDC. stdio
# (printf) is wired to UART1 on the 5-pin debug header instead —
# see firmware/README.md §Debugging.
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", \
    ATTRS{idVendor}=="0545", ATTRS{idProduct}=="0101", \
    ATTRS{bInterfaceNumber}=="00", \
    MODE="0660", GROUP="dialout", \
    SYMLINK+="rpbridge-uart1-rs232"

SUBSYSTEM=="tty", SUBSYSTEMS=="usb", \
    ATTRS{idVendor}=="0545", ATTRS{idProduct}=="0101", \
    ATTRS{bInterfaceNumber}=="02", \
    MODE="0660", GROUP="dialout", \
    SYMLINK+="rpbridge-uart1-rs485"

SUBSYSTEM=="tty", SUBSYSTEMS=="usb", \
    ATTRS{idVendor}=="0545", ATTRS{idProduct}=="0101", \
    ATTRS{bInterfaceNumber}=="04", \
    MODE="0660", GROUP="dialout", \
    SYMLINK+="rpbridge-uart1-ttl"

SUBSYSTEM=="tty", SUBSYSTEMS=="usb", \
    ATTRS{idVendor}=="0545", ATTRS{idProduct}=="0101", \
    ATTRS{bInterfaceNumber}=="06", \
    MODE="0660", GROUP="dialout", \
    SYMLINK+="rpbridge-uart2"
